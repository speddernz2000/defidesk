  "vars": {
    "ACCESS_TEAM": "https://scottpedder-nz.cloudflareaccess.com",
    "ACCESS_AUD": "b8de8a0f65080fee3aea1f95e2957cc65828877c5174ee0efb305529bf3cee6e"
  }
}
